{
  "uid": "rag-api-overview",
  "title": "RAG API - overview",
  "description": "SLOs, traffic, dependencies and guardrails for the multi-tenant RAG API. Every panel uses metrics the app really exports (validated by scripts/check_metric_names.py); thresholds mirror DOCS/14_SLOS_AND_RUNBOOKS.md and deploy/observability/prometheus/alerts.yml.",
  "tags": ["rag", "slo"],
  "timezone": "browser",
  "editable": true,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "1m",
  "time": {"from": "now-6h", "to": "now"},
  "graphTooltip": 1,
  "templating": {
    "list": [
      {
        "name": "ds",
        "label": "Prometheus",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "name": "Firing alerts",
        "datasource": {"type": "prometheus", "uid": "${ds}"},
        "enable": true,
        "iconColor": "red",
        "expr": "ALERTS{job=\"rag-api\",alertstate=\"firing\"}",
        "titleFormat": "{{alertname}}",
        "textFormat": "{{severity}}"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Service level objectives (30 d window)",
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 0},
      "collapsed": false,
      "panels": []
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Availability",
      "description": "SLO-A: at least 99.5 % of requests answered without a 5xx over 30 days. /healthz and /readyz are not instrumented, so this is real traffic only.",
      "datasource": {"type": "prometheus", "uid": "${ds}"},
      "gridPos": {"h": 5, "w": 6, "x": 0, "y": 1},
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 3,
          "min": 0.98,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "red", "value": null},
              {"color": "orange", "value": 0.99},
              {"color": "green", "value": 0.995}
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto",
        "justifyMode": "auto",
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {"type": "prometheus", "uid": "${ds}"},
          "editorMode": "code",
          "expr": "1 - (sum(increase(http_requests_total{job=\"rag-api\",status=\"5xx\"}[30d])) / sum(increase(http_requests_total{job=\"rag-api\"}[30d])))",
          "legendFormat": "availability"
        }
      ]
    },
    {
      "id": 3,
      "type": "gauge",
      "title": "Error budget consumed",
      "description": "Share of the 0.5 % monthly 5xx budget already spent. At 100 % the SLO is missed; freeze risky changes well before that.",
      "datasource": {"type": "prometheus", "uid": "${ds}"},
      "gridPos": {"h": 5, "w": 6, "x": 6, "y": 1},
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 1,
          "min": 0,
          "max": 1.5,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 0.5},
              {"color": "orange", "value": 0.8},
              {"color": "red", "value": 1}
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "showThresholdLabels": false,
        "showThresholdMarkers": true,
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {"type": "prometheus", "uid": "${ds}"},
          "editorMode": "code",
          "expr": "(sum(increase(http_requests_total{job=\"rag-api\",status=\"5xx\"}[30d])) / sum(increase(http_requests_total{job=\"rag-api\"}[30d]))) / 0.005",
          "legendFormat": "budget consumed"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "p95 latency (5 m)",
      "description": "SLO-L1: 95 % of requests under 5 s. From the unlabelled http_request_duration_highr_seconds histogram (the per-handler one only has 0.1/0.5/1 s buckets).",
      "datasource": {"type": "prometheus", "uid": "${ds}"},
      "gridPos": {"h": 5, "w": 6, "x": 12, "y": 1},
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "orange", "value": 5},
              {"color": "red", "value": 10}
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto",
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {"type": "prometheus", "uid": "${ds}"},
          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_highr_seconds_bucket{job=\"rag-api\"}[5m])))",
          "legendFormat": "p95"
        }
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Pods ready",
      "description": "rag_ready is set by each pod's own /readyz probe. 0 of n means the Service has no ready endpoints: the API is down for users.",
      "datasource": {"type": "prometheus", "uid": "${ds}"},
      "gridPos": {"h": 5, "w": 6, "x": 18, "y": 1},
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "red", "value": null},
              {"color": "green", "value": 1}
            ]
          }
        },
        "overrides": [
          {
            "matcher": {"id": "byName", "options": "pods"},
            "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "text"}}]
          }
        ]
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value_and_name",
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {"type": "prometheus", "uid": "${ds}"},
          "editorMode": "code",
          "expr": "sum(rag_ready{job=\"rag-api\"})",
          "legendFormat": "ready"
        },
        {
          "refId": "B",
          "datasource": {"type": "prometheus", "uid": "${ds}"},
          "editorMode": "code",
          "expr": "count(rag_ready{job=\"rag-api\"})",
          "legendFormat": "pods"
        }
      ]
    },
    {
      "id": 10,
      "type": "row",
      "title": "Traffic, errors and latency",
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 6},
      "collapsed": false,
      "panels": []
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Request rate by status class",
      "description": "prometheus-fastapi-instrumentator groups status into 2xx/4xx/5xx, so a 429 cannot be told apart here - use the rate-limit panel below.",
      "datasource": {"type": "prometheus", "uid": "${ds}"},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 7},
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "color": {"mode": "palette-classic-by-name"},
          "custom": {"drawStyle": "line", "lineWidth": 2, "fillOpacity": 10, "showPoints": "never", "stacking": {"mode": "normal", "group": "A"}}
        },
        "overrides": [
          {
            "matcher": {"id": "byName", "options": "5xx"},
            "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "red"}}]
          }
        ]
      },
      "options": {
        "legend": {"displayMode": "table", "placement": "bottom", "showLegend": true, "calcs": ["lastNotNull", "max"]},
        "tooltip": {"mode": "multi", "sort": "desc"}
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {"type": "prometheus", "uid": "${ds}"},
          "editorMode": "code",
          "expr": "sum by (status) (rate(http_requests_total{job=\"rag-api\"}[5m]))",
          "legendFormat": "{{status}}"
        }
      ]
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "5xx ratio vs burn-rate thresholds",
      "description": "Dashed lines are the alert thresholds: 7.2 % = RagHighErrorRateFastBurn (14.4x budget), 3 % = RagHighErrorRateSlowBurn (6x budget).",
      "datasource": {"type": "prometheus", "uid": "${ds}"},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 7},
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 2,
          "min": 0,
          "color": {"mode": "palette-classic-by-name"},
          "custom": {
            "drawStyle": "line", "lineWidth": 2, "fillOpacity": 8, "showPoints": "never",
            "thresholdsStyle": {"mode": "dashed"}
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "transparent", "value": null},
              {"color": "orange", "value": 0.03},
              {"color": "red", "value": 0.072}
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {"displayMode": "list", "placement": "bottom", "showLegend": true, "calcs": []},
        "tooltip": {"mode": "multi", "sort": "desc"}
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {"type": "prometheus", "uid": "${ds}"},
          "editorMode": "code",
          "expr": "sum(rate(http_requests_total{job=\"rag-api\",status=\"5xx\"}[5m])) / sum(rate(http_requests_total{job=\"rag-api\"}[5m]))",
          "legendFormat": "5xx ratio (5 m)"
        },
        {
          "refId": "B",
          "datasource": {"type": "prometheus", "uid": "${ds}"},
          "editorMode": "code",
          "expr": "sum(rate(http_requests_total{job=\"rag-api\",status=\"5xx\"}[1h])) / sum(rate(http_requests_total{job=\"rag-api\"}[1h]))",
          "legendFormat": "5xx ratio (1 h)"
        }
      ]
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Request latency quantiles",
      "description": "One axis, one unit: all quantiles come from the same histogram. A p99 far above p95 means a slow tail (retrieval loops, upstream retries), not a general slowdown.",
      "datasource": {"type": "prometheus", "uid": "${ds}"},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 15},
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 2,
          "min": 0,
          "color": {"mode": "palette-classic-by-name"},
          "custom": {"drawStyle": "line", "lineWidth": 2, "fillOpacity": 0, "showPoints": "never"},
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "transparent", "value": null},
              {"color": "orange", "value": 5},
              {"color": "red", "value": 10}
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {"displayMode": "table", "placement": "bottom", "showLegend": true, "calcs": ["lastNotNull", "max"]},
        "tooltip": {"mode": "multi", "sort": "desc"}
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {"type": "prometheus", "uid": "${ds}"},
          "editorMode": "code",
          "expr": "histogram_quantile(0.50, sum by (le) (rate(http_request_duration_highr_seconds_bucket{job=\"rag-api\"}[5m])))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "datasource": {"type": "prometheus", "uid": "${ds}"},
          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_highr_seconds_bucket{job=\"rag-api\"}[5m])))",
          "legendFormat": "p95"
        },
        {
          "refId": "C",
          "datasource": {"type": "prometheus", "uid": "${ds}"},
          "editorMode": "code",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(http_request_duration_highr_seconds_bucket{job=\"rag-api\"}[5m])))",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Failures surfaced to clients, by cause",
      "description": "rag_upstream_errors_total counts every AppError by exception class. SessionBusy and RebuildInProgress are 409s (caller/ops conditions), not outages.",
      "datasource": {"type": "prometheus", "uid": "${ds}"},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 15},
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "color": {"mode": "palette-classic-by-name"},
          "custom": {"drawStyle": "line", "lineWidth": 2, "fillOpacity": 10, "showPoints": "never", "stacking": {"mode": "normal", "group": "A"}}
        },
        "overrides": []
      },
      "options": {
        "legend": {"displayMode": "table", "placement": "bottom", "showLegend": true, "calcs": ["lastNotNull", "max"]},
        "tooltip": {"mode": "multi", "sort": "desc"}
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {"type": "prometheus", "uid": "${ds}"},
          "editorMode": "code",
          "expr": "sum by (upstream) (rate(rag_upstream_errors_total{job=\"rag-api\"}[5m]))",
          "legendFormat": "{{upstream}}"
        }
      ]
    },
    {
      "id": 20,
      "type": "row",
      "title": "Dependencies and protection",
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 23},
      "collapsed": false,
      "panels": []
    },
    {
      "id": 21,
      "type": "state-timeline",
      "title": "Readiness by dependency",
      "description": "Worst value across pods for each /readyz check. This is the panel that names what broke when RagReadinessFailing fires.",
      "datasource": {"type": "prometheus", "uid": "${ds}"},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 24},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "custom": {"fillOpacity": 85, "lineWidth": 0},
          "mappings": [
            {"type": "value", "options": {"0": {"text": "failing", "color": "red", "index": 0}}},
            {"type": "value", "options": {"1": {"text": "ok", "color": "green", "index": 1}}}
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "red", "value": null},
              {"color": "green", "value": 1}
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "showValue": "never",
        "mergeValues": true,
        "legend": {"displayMode": "list", "placement": "bottom", "showLegend": true},
        "tooltip": {"mode": "single", "sort": "none"}
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {"type": "prometheus", "uid": "${ds}"},
          "editorMode": "code",
          "expr": "min by (check) (rag_ready_check{job=\"rag-api\"})",
          "legendFormat": "{{check}}"
        }
      ]
    },
    {
      "id": 22,
      "type": "timeseries",
      "title": "Circuit breakers open (worker processes)",
      "description": "Breakers are per worker process: the value is how many processes are failing fast for that upstream. Trips/15 m shows flapping that the gauge hides.",
      "datasource": {"type": "prometheus", "uid": "${ds}"},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 24},
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "decimals": 0,
          "color": {"mode": "palette-classic-by-name"},
          "custom": {"drawStyle": "line", "lineWidth": 2, "fillOpacity": 15, "showPoints": "never"}
        },
        "overrides": [
          {
            "matcher": {"id": "byRegexp", "options": ".*trips.*"},
            "properties": [{"id": "custom.lineStyle", "value": {"fill": "dash", "dash": [8, 4]}}, {"id": "custom.fillOpacity", "value": 0}]
          }
        ]
      },
      "options": {
        "legend": {"displayMode": "table", "placement": "bottom", "showLegend": true, "calcs": ["lastNotNull", "max"]},
        "tooltip": {"mode": "multi", "sort": "desc"}
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {"type": "prometheus", "uid": "${ds}"},
          "editorMode": "code",
          "expr": "sum by (upstream) (rag_circuit_breaker_open{job=\"rag-api\"})",
          "legendFormat": "{{upstream}} open"
        },
        {
          "refId": "B",
          "datasource": {"type": "prometheus", "uid": "${ds}"},
          "editorMode": "code",
          "expr": "sum by (upstream) (increase(rag_circuit_breaker_trips_total{job=\"rag-api\"}[15m]))",
          "legendFormat": "{{upstream}} trips/15 m"
        }
      ]
    },
    {
      "id": 23,
      "type": "timeseries",
      "title": "Rate-limit rejections by window",
      "description": "minute/day are the per-key limits, auth_fail is the per-IP penalty box, fallback means Redis was unavailable and the in-process limiter rejected the request.",
      "datasource": {"type": "prometheus", "uid": "${ds}"},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 32},
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "color": {"mode": "palette-classic-by-name"},
          "custom": {"drawStyle": "line", "lineWidth": 2, "fillOpacity": 10, "showPoints": "never", "stacking": {"mode": "normal", "group": "A"}}
        },
        "overrides": []
      },
      "options": {
        "legend": {"displayMode": "table", "placement": "bottom", "showLegend": true, "calcs": ["lastNotNull", "max"]},
        "tooltip": {"mode": "multi", "sort": "desc"}
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {"type": "prometheus", "uid": "${ds}"},
          "editorMode": "code",
          "expr": "sum by (window) (rate(rag_rate_limited_total{job=\"rag-api\"}[5m]))",
          "legendFormat": "{{window}}"
        },
        {
          "refId": "B",
          "datasource": {"type": "prometheus", "uid": "${ds}"},
          "editorMode": "code",
          "expr": "sum(rate(rag_limiter_fallback_total{job=\"rag-api\"}[5m]))",
          "legendFormat": "in-process fallback"
        }
      ]
    },
    {
      "id": 24,
      "type": "timeseries",
      "title": "Direct-Groq key failover",
      "description": "rag_llm_key_failover_total increments when the primary Groq key fails and the call is retried on GROQ_FALLBACK_API_KEY, labelled by the exception that caused it. A steady rate means the primary key is unhealthy.",
      "datasource": {"type": "prometheus", "uid": "${ds}"},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 32},
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "color": {"mode": "palette-classic-by-name"},
          "custom": {"drawStyle": "bars", "lineWidth": 1, "fillOpacity": 70, "showPoints": "never", "stacking": {"mode": "normal", "group": "A"}}
        },
        "overrides": []
      },
      "options": {
        "legend": {"displayMode": "table", "placement": "bottom", "showLegend": true, "calcs": ["sum"]},
        "tooltip": {"mode": "multi", "sort": "desc"}
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {"type": "prometheus", "uid": "${ds}"},
          "editorMode": "code",
          "expr": "sum by (reason) (increase(rag_llm_key_failover_total{job=\"rag-api\"}[15m]))",
          "legendFormat": "{{reason}}"
        }
      ]
    },
    {
      "id": 30,
      "type": "row",
      "title": "Guardrails, cost and caches",
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 40},
      "collapsed": false,
      "panels": []
    },
    {
      "id": 31,
      "type": "timeseries",
      "title": "Guardrail blocks by stage and rail",
      "description": "A spike in input/self check input is usually an attack wave; a spike in output/<deterministic rail name> is usually a regression in the responder or in retrieval. RagGuardrailBlockSpike fires at 3x the 6 h average.",
      "datasource": {"type": "prometheus", "uid": "${ds}"},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 41},
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "color": {"mode": "palette-classic-by-name"},
          "custom": {"drawStyle": "bars", "lineWidth": 1, "fillOpacity": 70, "showPoints": "never", "stacking": {"mode": "normal", "group": "A"}}
        },
        "overrides": []
      },
      "options": {
        "legend": {"displayMode": "table", "placement": "bottom", "showLegend": true, "calcs": ["sum"]},
        "tooltip": {"mode": "multi", "sort": "desc"}
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {"type": "prometheus", "uid": "${ds}"},
          "editorMode": "code",
          "expr": "sum by (stage, rail) (increase(rag_guardrail_blocks_total{job=\"rag-api\"}[10m]))",
          "legendFormat": "{{stage}} / {{rail}}"
        },
        {
          "refId": "B",
          "datasource": {"type": "prometheus", "uid": "${ds}"},
          "editorMode": "code",
          "expr": "sum by (action) (increase(rag_injection_chunks_total{job=\"rag-api\"}[10m]))",
          "legendFormat": "retrieved chunk {{action}}"
        }
      ]
    },
    {
      "id": 32,
      "type": "timeseries",
      "title": "LLM tokens per second by feature",
      "description": "Cost and provider-limit pressure. The planner and rewrite features run on the cheap model; a sudden climb in 'responder' prompt tokens usually means the context assembly grew.",
      "datasource": {"type": "prometheus", "uid": "${ds}"},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 41},
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "color": {"mode": "palette-classic-by-name"},
          "custom": {"drawStyle": "line", "lineWidth": 2, "fillOpacity": 10, "showPoints": "never", "stacking": {"mode": "normal", "group": "A"}}
        },
        "overrides": []
      },
      "options": {
        "legend": {"displayMode": "table", "placement": "bottom", "showLegend": true, "calcs": ["lastNotNull", "max"]},
        "tooltip": {"mode": "multi", "sort": "desc"}
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {"type": "prometheus", "uid": "${ds}"},
          "editorMode": "code",
          "expr": "sum by (feature, kind) (rate(rag_llm_tokens_total{job=\"rag-api\"}[5m]))",
          "legendFormat": "{{feature}} {{kind}}"
        }
      ]
    },
    {
      "id": 33,
      "type": "timeseries",
      "title": "Cache hit ratio",
      "description": "Embedding cache (exact text) and semantic cache (vector similarity). Both are optimisations: a drop costs latency and tokens but never correctness. Shown only while the cache is being used.",
      "datasource": {"type": "prometheus", "uid": "${ds}"},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 49},
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "decimals": 1,
          "color": {"mode": "palette-classic-by-name"},
          "custom": {"drawStyle": "line", "lineWidth": 2, "fillOpacity": 0, "showPoints": "never", "spanNulls": false}
        },
        "overrides": []
      },
      "options": {
        "legend": {"displayMode": "table", "placement": "bottom", "showLegend": true, "calcs": ["lastNotNull", "mean"]},
        "tooltip": {"mode": "multi", "sort": "desc"}
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {"type": "prometheus", "uid": "${ds}"},
          "editorMode": "code",
          "expr": "sum(rate(rag_embed_cache_total{job=\"rag-api\",result=\"hit\"}[10m])) / sum(rate(rag_embed_cache_total{job=\"rag-api\"}[10m]))",
          "legendFormat": "embedding cache"
        },
        {
          "refId": "B",
          "datasource": {"type": "prometheus", "uid": "${ds}"},
          "editorMode": "code",
          "expr": "sum(rate(rag_semcache_total{job=\"rag-api\",result=\"hit\"}[10m])) / sum(rate(rag_semcache_total{job=\"rag-api\",result=~\"hit|miss\"}[10m]))",
          "legendFormat": "semantic cache"
        }
      ]
    },
    {
      "id": 34,
      "type": "timeseries",
      "title": "Ingestion queue depth and worker heartbeat age",
      "description": "Queue depth is the ZCARD of the arq queue (deferred jobs included). Heartbeat age above 180 s means no worker replica is refreshing it: queued jobs are not being picked up.",
      "datasource": {"type": "prometheus", "uid": "${ds}"},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 49},
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "color": {"mode": "palette-classic-by-name"},
          "custom": {"drawStyle": "line", "lineWidth": 2, "fillOpacity": 10, "showPoints": "never"}
        },
        "overrides": [
          {
            "matcher": {"id": "byName", "options": "heartbeat age"},
            "properties": [
              {"id": "unit", "value": "s"},
              {"id": "custom.fillOpacity", "value": 0},
              {"id": "custom.lineStyle", "value": {"fill": "dash", "dash": [8, 4]}},
              {"id": "color", "value": {"mode": "fixed", "fixedColor": "orange"}}
            ]
          }
        ]
      },
      "options": {
        "legend": {"displayMode": "table", "placement": "bottom", "showLegend": true, "calcs": ["lastNotNull", "max"]},
        "tooltip": {"mode": "multi", "sort": "desc"}
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {"type": "prometheus", "uid": "${ds}"},
          "editorMode": "code",
          "expr": "max(rag_ingest_queue_depth{job=\"rag-worker\"})",
          "legendFormat": "queue depth (jobs)"
        },
        {
          "refId": "B",
          "datasource": {"type": "prometheus", "uid": "${ds}"},
          "editorMode": "code",
          "expr": "time() - max(rag_worker_heartbeat_timestamp_seconds{job=\"rag-worker\"})",
          "legendFormat": "heartbeat age"
        }
      ]
    },
    {
      "id": 35,
      "type": "timeseries",
      "title": "Advisory steps skipped (answers still returned, but degraded)",
      "description": "The planner and the query rewrite run on the cheap model and are advisory: when they fail the request still answers 200, so nothing shows up in the 5xx SLO. 'planner' means the search ran on the user's raw question; 'rewrite' means the retrieval loop gave up and returned the no-context answer. RagPipelineDegraded fires above 5 % of /query requests.",
      "datasource": {"type": "prometheus", "uid": "${ds}"},
      "gridPos": {"h": 7, "w": 24, "x": 0, "y": 57},
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "decimals": 2,
          "color": {"mode": "palette-classic-by-name"},
          "custom": {
            "drawStyle": "line", "lineWidth": 2, "fillOpacity": 10, "showPoints": "never",
            "thresholdsStyle": {"mode": "dashed"}
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "transparent", "value": null},
              {"color": "orange", "value": 0.05}
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {"displayMode": "table", "placement": "bottom", "showLegend": true, "calcs": ["lastNotNull", "max"]},
        "tooltip": {"mode": "multi", "sort": "desc"}
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {"type": "prometheus", "uid": "${ds}"},
          "editorMode": "code",
          "expr": "sum by (step) (rate(rag_degraded_total{job=\"rag-api\"}[15m])) / scalar(sum(rate(http_requests_total{job=\"rag-api\",handler=\"/query\"}[15m])))",
          "legendFormat": "{{step}} skipped"
        }
      ]
    }
  ]
}
