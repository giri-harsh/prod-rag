# Copy to .env and fill in:   cp .env.example .env     (Windows: Copy-Item .env.example .env)
# .env is git-ignored; this file is the only env file that is tracked. It must never contain real values.

APP_ENV=dev                        # dev | test | loadtest | prod   (prod requires the keys below)
LOG_LEVEL=INFO

# --- datastores (defaults match docker compose: ports are published on localhost) ---
DATABASE_URL=postgresql://rag:rag@localhost:5432/rag
DIRECT_DATABASE_URL=               # session-mode URL for migrations when DATABASE_URL goes through pgbouncer
REDIS_URL=redis://localhost:6379/0
QDRANT_URL=http://localhost:6333   # Qdrant Cloud: https://<cluster>.<region>.cloud.qdrant.io:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=enterprise_rag   # alias name; physical collections are <name>_v<N>

# --- LLM: Groq, either through the Portkey gateway or directly ---
USE_GATEWAY=true                   # true: via Portkey (needs PORTKEY_API_KEY). false: call Groq directly (no gateway, no Portkey cache)
GROQ_API_KEY=
GROQ_FALLBACK_API_KEY=             # optional second Groq key; direct mode fails over to it when the primary fails or is rate-limited
PORTKEY_API_KEY=
GROQ_SLUG=rag                      # Portkey virtual key names (see PORTKEY_SETUP.md)
GROQ_SLUG_FALLBACK=brag
LLM_PRIMARY_MODEL=openai/gpt-oss-120b
LLM_FALLBACK_MODEL=openai/gpt-oss-20b     # cheaper model: query rewriting and the gateway fallback target
GUARD_MODEL=openai/gpt-oss-20b            # NeMo guardrail classifier (the model DOCS/08 calibrated)
# The llama-3.x models these three used to name were retired by Groq; run scripts/check_keys.py after
# changing a key - it reports model_not_found and lists what the account can actually serve.
LLM_REASONING_EFFORT=low           # sent only to openai/gpt-oss-* models (low | medium | high)

# --- embeddings (Gemini) ---
GEMINI_API_KEY=
EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_DIM=768

# --- limits / timeouts ---
LLM_TIMEOUT_S=30
EMBED_TIMEOUT_S=10
QDRANT_TIMEOUT_S=5
LLM_CONCURRENCY=32
DEFAULT_RATE_PER_MIN=60
DEFAULT_RATE_PER_DAY=10000
MEMORY_TTL_DAYS=30
INGEST_BATCH_SIZE=128
INGEST_ROOT=DATA
TRUSTED_PROXIES=                   # comma-separated IPs/CIDRs allowed to set X-Forwarded-For

# --- observability ---
LOGFIRE_TOKEN=
LANGSMITH_TRACING=false

# --- clients of the API (Streamlit UI / evals) ---
BACKEND_URL=http://localhost:8080
RAG_API_KEY=                       # an API key created with: python -m app.auth.cli create ... (add --scope eval for evals)
JUDGE_GROQ=                        # separate Groq key for the RAGAS judge (evals only)
JUDGE_RATE_LIMIT_WAIT_BUDGET_S=7200   # evals only: max seconds one judge call may spend waiting out Groq 429s before the run stops

# --- production deploy (docker-compose.prod.yml; see scripts/deploy/README.md) ---
# Passwords must be URL-safe (they are embedded in DATABASE_URL): generate with `openssl rand -hex 24`.
POSTGRES_PASSWORD=                 # postgres superuser "rag" AND the pgbouncer client password (pgbouncer AUTH_TYPE scram-sha-256)
# QDRANT_API_KEY (above) is also set on the Qdrant server as QDRANT__SERVICE__API_KEY in prod.
SITE_DOMAIN=localhost              # public host name for Caddy / Let's Encrypt (prod: rag.example.com); localhost = Caddy internal CA
WEB_CONCURRENCY=2                  # gunicorn workers per api container (prod overlay pins 2)
BFF_RAG_API_KEY=                   # the web BFF's API key for the tenant (written by scripts/deploy/verify_on_vm.sh; never reaches the browser)
BFF_ALLOWED_ORIGINS=               # standalone BFF only; the prod overlay sets https://$SITE_DOMAIN
BFF_TRUSTED_PROXIES=               # standalone BFF only; the prod overlay sets the compose subnet
